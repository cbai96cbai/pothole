# Export these in your shell (for example: set -a; source .env; set +a). Nothing loads .env itself.
# Your Azure OpenAI endpoint URL:
AZURE_OPENAI_ENDPOINT=
# Your Azure OpenAI key:
AZURE_OPENAI_API_KEY=
# Deployment name; empty means pothole-agent
POTHOLE_DEPLOYMENT=
# Optional Socrata app token for the NYC Open Data API; empty means anonymous requests
SOCRATA_APP_TOKEN=
# Where the pipeline keeps its local state; empty means ~/.cache/pothole
POTHOLE_STATE=
